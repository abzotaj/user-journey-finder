# Copy this file to `.env` and adjust the values. `.env` is gitignored.
# Next.js loads `.env` automatically when running `npm run dev`, `npm run build`
# and `npm run start`.

# Directory containing the output of a trizo-horus scan
# (https://github.com/abzotaj/trizo-horus): index.json plus per-journey files.
# Optional. Defaults to ./scan-output when unset. If neither location has scan
# output, the app falls back to the bundled sample data.
TRIZO_HORUS_OUTPUT_DIR=./scan-output
